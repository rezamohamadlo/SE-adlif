+        self.cohort = []
+        for dataset in ('SHD', 'SSC', 'ECG'):
+            self.plan['frozen_configurations'][dataset] = {}
+            for arm in ('Baseline', 'A', 'B', 'A+B'):
+                cfg = dict(random_seed=42, paper_baseline_dataset=dataset,

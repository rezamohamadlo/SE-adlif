+"""Draft adapters for a future frozen SHD* final test, never development.
+
+No training and no candidate selection. The entrypoint remains responsible
+for the complete final-cohort/checkpoint/config/source gate BEFORE calling.
+"""
+import hashlib
+import json
+import math
+from pathlib import Path
+
+import h5py
+from omegaconf import OmegaConf
+from torch.utils.data import DataLoader, Subset
+
+from datasets.shd import SHDWrapper
+from project_paths import local_path, portable_path
+from module.shd_final_provenance import (
+    verify_canonical_fitting_membership, verify_original_row_loader,
+)
+from module.ordinary_prediction_capture import capture_ordinary_classification
+from module.speaker_generalization import summarize_speaker_generalization
+
+
+def _sha256(path):
+    with Path(path).open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def prepare_final_shd_evaluation(cfg, datamodule, plan, authorization, test_file):
+    """After the full gate, bind actual metadata and build one original-row loader.
+
+    Returns ephemeral raw metadata separately from serializable provenance.
+    The original SHDLDM constructor already builds its subsets; its setup and
+    prepare_data are no-ops. No model inference is performed here.
+    """
+    if (plan.get('status') != 'frozen' or plan.get('purpose') != 'final'
+            or plan.get('test_selects_ideas') is not False
+            or authorization.get('purpose') != 'final'
+            or authorization.get('verified_configurations') != 36
+            or authorization.get('dataset') != 'SHD'):
+        raise ValueError('Complete frozen four-arm final authorization must precede SHD data access')
+    settings = plan.get('shd_generalization', {})
+    if settings.get('ordinary_speaker_breakdown') is not True:
+        raise ValueError('Final plan must preregister the ordinary SHD speaker breakdown')
+    cfg = OmegaConf.to_container(cfg, resolve=True) if OmegaConf.is_config(cfg) else cfg
+    dataset_cfg = cfg.get('dataset', {})
+    if (cfg.get('paper_baseline_dataset') != 'SHD'
+            or dataset_cfg.get('bias_for_test_set', 0) != 0
+            or dataset_cfg.get('test_bias_variant', 'bias') not in ('bias', 'none')
+            or dataset_cfg.get('train_augmentation')):
+        raise ValueError('Final SHD evaluation requires the frozen clean ordinary pipeline')
+    if (type(datamodule.train_val_ds) is not SHDWrapper
+            or type(datamodule.data_train) is not Subset
+            or type(datamodule.data_val) is not Subset
+            or datamodule.data_train.dataset is not datamodule.train_val_ds
+            or datamodule.data_val.dataset is not datamodule.train_val_ds):
+        raise ValueError('Actual fitting/validation subsets must share the original training source')
+    train_file = Path(datamodule.train_val_ds.location_on_system, datamodule.train_val_ds.data_filename)
+    if train_file.name != 'shd_train.h5':
+        raise ValueError('Fitting metadata must come from the official training file')
+    manifest_path = local_path(settings['canonical_split_manifest'], must_exist=True)
+    manifest_bytes = manifest_path.read_bytes()
+    train_sha = _sha256(train_file)
+    with h5py.File(train_file, 'r') as source:
+        train_labels = source['labels'][:].reshape(-1).tolist()
+        train_speakers = source['extra/speaker'][:].reshape(-1).tolist()
+    membership = verify_canonical_fitting_membership(
+        manifest_bytes, settings['canonical_split_manifest_sha256'], train_sha,
+        train_labels, train_speakers, datamodule.data_train.indices,
+        datamodule.data_val.indices, cfg,
+    )
+    raw = datamodule.data_test
+    test_file = local_path(test_file, must_exist=True)
+    if (type(raw) is not SHDWrapper or raw.data_filename != 'shd_test.h5'
+            or Path(raw.location_on_system, raw.data_filename).resolve() != test_file.resolve()
+            or authorization.get('test_data_sha256') != _sha256(test_file)):
+        raise ValueError('Original test source differs from final authorized identity')
+    with h5py.File(test_file, 'r') as source:
+        labels = source['labels'][:].reshape(-1).tolist()
+        speakers = source['extra/speaker'][:].reshape(-1).tolist()
+    if datamodule.batch_size != cfg.get('batch_size'):
+        raise ValueError('Final evaluation batch differs from the frozen checkpoint')
+    loader = DataLoader(raw, shuffle=False, drop_last=False,
+                        batch_size=datamodule.batch_size, collate_fn=datamodule.collate_fn,
+                        num_workers=datamodule.num_workers, pin_memory=True,
+                        persistent_workers=datamodule.num_workers > 0)
+    loader_evidence = verify_original_row_loader(
+        loader, raw, test_file, len(labels), datamodule.batch_size,
+        datamodule.static_data_transform_test,
+    )
+    return dict(loader=loader, metadata_labels=labels, metadata_speakers=speakers,
+                provenance=dict(membership=membership, loader=loader_evidence,
+                                canonical_split_manifest=portable_path(manifest_path),
+                                test_data=portable_path(test_file),
+                                test_data_sha256=authorization['test_data_sha256'],
+                                evaluation_workers=datamodule.num_workers,
+                                ordinary_inference=True, test_time_augmentation=False))
+
+
+def evaluate_prepared_shd(model, trainer, prepared):
+    """Capture exactly the existing ordinary test forwards; verify all totals.
+
+    The caller persists the returned summary/rows with the checkpoint and plan
+    identities. Preparing/calling this outside the frozen gate is prohibited.
+    """
+    count = prepared['provenance']['loader']['recordings']
+    if model.output_size != 20:
+        raise ValueError('Final SHD speaker accounting requires the declared20classes')
+    with capture_ordinary_classification(model, count) as capture:
+        results = trainer.test(model, dataloaders=prepared['loader'])
+        rows = capture.finalize()
+    if len(results) != 1:
+        raise ValueError('Require one complete ordinary SHD test loader')
+    result = results[0]
+    summary = summarize_speaker_generalization(
+        rows['predictions'], rows['observed_labels'], rows['row_ids'],
+        prepared['metadata_labels'], prepared['metadata_speakers'],
+        prepared['provenance']['membership']['fitting_speaker_ids'], num_classes=20,
+    )
+    if (not math.isfinite(float(result['test_acc']))
+            or not math.isclose(float(result['test_acc']), summary['groups']['all']['accuracy'],
+                                rel_tol=0, abs_tol=2e-7)):
+        raise ValueError('Speaker-group counts disagree with the ordinary overall test metric')
+    return result, dict(summary, provenance=prepared['provenance']), rows

+++ b/module/shd_final_provenance.py
@@ -0,0 +1,143 @@
+"""Draft final SHD* provenance guards; never fit models or choose candidates.
+
+Use only after the final evaluation gate. Membership uses official-training
+metadata supplied by the caller. Loader inspection may call dataset.__len__;
+it therefore belongs after authorization to access the final cohort.
+"""
+import hashlib
+import json
+import math
+from numbers import Integral
+from pathlib import Path
+import re
+from collections import Counter
+
+import torch
+from torch.utils.data import DataLoader, BatchSampler, SequentialSampler
+
+
+def _integers(values, name):
+    values = list(values)
+    if any(isinstance(x, bool) or not isinstance(x, Integral) for x in values):
+        raise ValueError(f'{name} must contain integer IDs')
+    return [int(x) for x in values]
+
+
+def verify_canonical_fitting_membership(
+    manifest_bytes, expected_manifest_sha256, source_sha256,
+    train_labels, train_speakers, fitting_indices, validation_indices, cfg,
+):
+    """Bind actual fitting indices to frozen bytes and training-file identity.
+
+    The caller hashes the actual HDF5 source and reads its metadata. This
+    helper cannot independently prove where supplied arrays came from.
+    Regenerating the split here verifies the fixed algorithm, not a new split.
+    """
+    if (not isinstance(manifest_bytes, bytes)
+            or not isinstance(expected_manifest_sha256, str)
+            or re.fullmatch('[0-9a-f]{64}', expected_manifest_sha256) is None
+            or hashlib.sha256(manifest_bytes).hexdigest() != expected_manifest_sha256):
+        raise ValueError('Canonical manifest bytes differ from the frozen digest')
+    manifest = json.loads(manifest_bytes)
+    dataset = cfg.get('dataset', {})
+    if (manifest.get('version') != 'canonical_shd_split_v1'
+            or manifest.get('dataset_label') != 'SHD*'
+            or manifest.get('validate_on') != .2 or manifest.get('split_seed') != 42
+            or manifest.get('official_test_opened') is not False
+            or dataset.get('validate_on') != .2 or dataset.get('random_seed') != 42
+            or dataset.get('additional_test_set_validation', False)
+            or dataset.get('speaker_split_manifest')
+            or dataset.get('speaker_split_fingerprint')
+            or cfg.get('init_ckpt_path')):
+        raise ValueError('Require fresh canonical SHD* fitting protocol, not speaker exposure or test selection')
+    if (not isinstance(source_sha256, str)
+            or re.fullmatch('[0-9a-f]{64}', source_sha256) is None
+            or manifest.get('source_sha256') != source_sha256):
+        raise ValueError('Training-file identity differs from the frozen split')
+    labels = _integers(train_labels, 'training labels')
+    speakers = _integers(train_speakers, 'training speakers')
+    fitting = _integers(fitting_indices, 'fitting indices')
+    validation = _integers(validation_indices, 'validation indices')
+    if (not labels or len(labels) != len(speakers)
+            or any(not 0 <= x < 20 for x in labels) or any(x < 0 for x in speakers)):
+        raise ValueError('Invalid aligned training-file labels/speakers')
+    valid_count = math.floor(len(labels) * .2)
+    order = torch.randperm(len(labels), generator=torch.Generator().manual_seed(42)).tolist()
+    expected_fit, expected_val = order[:-valid_count], order[-valid_count:]
+    if (not valid_count or fitting != expected_fit or validation != expected_val
+            or manifest.get('train', {}).get('indices') != expected_fit
+            or manifest.get('validation', {}).get('indices') != expected_val):
+        raise ValueError('Actual fitting/validation indices differ from the frozen canonical algorithm')
+    if any({labels[i] for i in indices} != set(range(20)) for indices in (fitting, validation)):
+        raise ValueError('Canonical fitting and validation must retain all20classes')
+    for name, indices in (('train', fitting), ('validation', validation)):
+        subset = manifest[name]
+        counts = Counter(labels[i] for i in indices)
+        speaker_counts = Counter(speakers[i] for i in indices)
+        if (subset.get('record_count') != len(indices)
+                or subset.get('class_counts') != [counts[i] for i in range(20)]
+                or subset.get('speaker_ids') != sorted(speaker_counts)
+                or subset.get('per_speaker_record_counts') != {str(k): v for k, v in speaker_counts.items()}):
+            raise ValueError('Frozen split counts or speaker membership disagree with original training rows')
+    return dict(
+        fitting_records=len(fitting), validation_records=len(validation),
+        fitting_speaker_ids=sorted({speakers[i] for i in fitting}),
+        training_file_speaker_ids=sorted(set(speakers)),
+        manifest_sha256=expected_manifest_sha256, training_source_sha256=source_sha256,
+        declared_split_fingerprint=manifest.get('fingerprint'),
+        split_seed=42, dataset_label='SHD*',
+    )
+
+
+def verify_original_row_loader(
+    loader, raw_dataset, expected_file, expected_records, expected_batch_size,
+    expected_transform,
+):
+    """Require complete unwrapped original-row SHD evaluation.
+
+    Existing disk caches are deliberately not accepted by this draft path.
+    The future evaluator must supply an uncached loader retaining the frozen
+    preprocessing/collation/batch settings, after checking file SHA/metadata.
+    No dataset item or model forward is requested by this guard.
+    """
+    from datasets.shd import SHDWrapper
+    from datasets.utils.pad_tensors import PadTensors
+
+    for value in (expected_records, expected_batch_size):
+        if isinstance(value, bool) or not isinstance(value, Integral) or value < 1:
+            raise ValueError('Expected positive recording count and batch size')
+    if (type(loader) is not DataLoader or type(raw_dataset) is not SHDWrapper
+            or loader.dataset is not raw_dataset):
+        raise ValueError('Require the original SHD dataset, without cache/subset/reordering wrappers')
+    if raw_dataset.data_filename != 'shd_test.h5' or Path(expected_file).name != 'shd_test.h5':
+        raise ValueError('Final loader must refer to the official-test filename')
+    try:
+        actual_file = Path(raw_dataset.location_on_system, raw_dataset.data_filename).resolve(strict=True)
+        frozen_file = Path(expected_file).resolve(strict=True)
+    except OSError as exc:
+        raise ValueError('Missing original HDF5 source') from exc
+    if actual_file != frozen_file:
+        raise ValueError('Loader refers to a different original HDF5 source')
+    if (raw_dataset.target_transform is not None or expected_transform is None
+            or raw_dataset.transform is not expected_transform):
+        raise ValueError('Loader input/label transforms differ from the verified clean pipeline')
+    if (type(loader.sampler) is not SequentialSampler
+            or loader.sampler.data_source is not raw_dataset
+            or type(loader.batch_sampler) is not BatchSampler
+            or loader.batch_sampler.sampler is not loader.sampler
+            or loader.drop_last or loader.batch_sampler.drop_last
+            or loader.batch_size != expected_batch_size
+            or loader.batch_sampler.batch_size != expected_batch_size):
+        raise ValueError('Require sequential exhaustive sampling at the frozen batch size')
+    collate = loader.collate_fn
+    if (type(collate) is not PadTensors or not collate.batch_first
+            or not collate.require_padding or collate.batch_dim != 0 or collate.temp_dim != 1
+            or collate.call_fn is not PadTensors._call_with_padding):
+        raise ValueError('Classification collation differs from the established target/mask contract')
+    if len(raw_dataset) != expected_records or len(loader.sampler) != expected_records:
+        raise ValueError('Loader does not cover the complete original recording cohort')
+    if len(loader) != math.ceil(expected_records / expected_batch_size):
+        raise ValueError('Unexpected evaluation batch count')
+    return dict(recordings=int(expected_records), batch_size=int(expected_batch_size),
+                batches=len(loader), original_row_order='0..N-1', cached=False,
+                sampler='SequentialSampler', drop_last=False)

+"""Synthetic create-only evidence archives; no model or real dataset access."""
+import copy
+import hashlib
+from pathlib import Path
+import tempfile
+import unittest
+
+import numpy as np
+from module.shd_final_evaluation import persist_shd_rows, verify_saved_shd_rows
+from module.speaker_generalization import summarize_speaker_generalization
+
+
+class PredictionRowsTests(unittest.TestCase):
+    def setUp(self):
+        self.temp=tempfile.TemporaryDirectory();self.addCleanup(self.temp.cleanup)
+        self.root=Path(self.temp.name)
+        self.rows=dict(row_ids=[0,1,2],observed_labels=[0,1,2],predictions=[0,0,2],
+                       observed_speaker_ids=[0,10,10])
+        names=['checkpoint_sha256','evaluation_plan_sha256','test_data_sha256',
+               'training_source_sha256','canonical_split_manifest_sha256']
+        self.identity={name:str(i+1)*64 for i,name in enumerate(names)}
+        self.identity.update(ordinary_inference=True,test_time_augmentation=False,fitting_speaker_ids=[0])
+
+    def save(self,rows=None,identity=None):
+        return persist_shd_rows(self.root,rows or self.rows,identity or self.identity)
+
+    def test_archive_roundtrip_and_group_counts_use_same_saved_rows(self):
+        record=self.save();path=Path(record['path'])
+        self.assertEqual(hashlib.sha256(path.read_bytes()).hexdigest(),record['sha256'])
+        rows=verify_saved_shd_rows(path,record['sha256'],self.identity)
+        self.assertEqual(rows,self.rows)
+        with np.load(path,allow_pickle=False) as archive:
+            self.assertEqual(archive['observed_speaker_ids'].dtype,np.dtype('int64'))
+        summary=summarize_speaker_generalization(
+            rows['predictions'],rows['observed_labels'],rows['row_ids'],rows['observed_labels'],
+            rows['observed_speaker_ids'],self.identity['fitting_speaker_ids'])
+        self.assertEqual(summary['groups']['all']['correct'],2)
+        self.assertEqual(summary['groups']['seen']['correct'],1)
+        self.assertEqual(summary['groups']['unseen']['correct'],1)
+
+    def test_identical_rerun_reuses_existing_bytes_and_timestamp(self):
+        first=self.save();path=Path(first['path']);before=(path.read_bytes(),path.stat().st_mtime_ns)
+        second=self.save()
+        self.assertEqual(first,second)
+        self.assertEqual(before,(path.read_bytes(),path.stat().st_mtime_ns))
+
+    def test_conflicting_checkpoint_or_prediction_never_overwrites(self):
+        saved=self.save();path=Path(saved['path']);before=path.read_bytes()
+        other=dict(self.identity,checkpoint_sha256='f'*64)
+        with self.assertRaises(ValueError):self.save(identity=other)
+        other=copy.deepcopy(self.rows);other['predictions']=[0,1,2]
+        with self.assertRaises(ValueError):self.save(rows=other)
+        self.assertEqual(path.read_bytes(),before)
+
+    def test_invalid_rows_or_identities_fail_before_creating_output(self):
+        cases=[]
+        for key,value in [('row_ids',[1,0,2]),('predictions',[0.,0.,2.]),
+                          ('predictions',[0,0,20]),('observed_labels',[0,1]),
+                          ('observed_speaker_ids',[0,-1,10]),('row_ids',[])]:
+            rows=copy.deepcopy(self.rows);rows[key]=value;cases.append((rows,self.identity))
+        for change in [dict(fitting_speaker_ids=[True]),dict(test_time_augmentation=True),
+                       dict(checkpoint_sha256='not-a-hash')]:
+            cases.append((self.rows,dict(self.identity,**change)))
+        for i,(rows,identity) in enumerate(cases):
+            directory=self.root/str(i)
+            with self.subTest(case=i),self.assertRaises(ValueError):
+                persist_shd_rows(directory,rows,identity)
+            self.assertFalse(directory.exists())
+
+    def test_hash_or_invalid_archive_rejected_without_modification(self):
+        record=self.save();path=Path(record['path'])
+        with self.assertRaisesRegex(ValueError,'hash differs'):
+            verify_saved_shd_rows(path,'f'*64,self.identity)
+        invalid=self.root/'invalid.npz';invalid.write_bytes(b'not an archive')
+        with self.assertRaises(ValueError):
+            verify_saved_shd_rows(invalid,hashlib.sha256(invalid.read_bytes()).hexdigest(),self.identity)
+        self.assertEqual(invalid.read_bytes(),b'not an archive')
+
+    def test_identity_mismatch_rejected_even_with_matching_archive_hash(self):
+        record=self.save();path=Path(record['path']);other=dict(self.identity,fitting_speaker_ids=[10])
+        with self.assertRaisesRegex(ValueError,'another checkpoint'):
+            verify_saved_shd_rows(path,record['sha256'],other)
+
+
+if __name__=='__main__':unittest.main()

+"""Draft adapters for a future frozen SHD* final test, never development.
+
+No training and no candidate selection. The entrypoint remains responsible
+for the complete final-cohort/checkpoint/config/source gate BEFORE calling.
+"""
+import hashlib
+import json
+import math
+from pathlib import Path
+import re
+import zipfile
+
+import h5py
+import numpy as np
+from omegaconf import OmegaConf
+from torch.utils.data import DataLoader, Subset
+
+from datasets.shd import SHDWrapper
+from project_paths import local_path, portable_path
+from module.shd_final_provenance import (
+    verify_canonical_fitting_membership, verify_original_row_loader,
+)
+from module.ordinary_prediction_capture import capture_ordinary_classification
+from module.speaker_generalization import summarize_speaker_generalization
+
+
+def _sha256(path):
+    with Path(path).open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def prepare_final_shd_evaluation(cfg, datamodule, plan, authorization, test_file):
+    """After the full gate, bind actual metadata and build one original-row loader.
+
+    Returns ephemeral raw metadata separately from serializable provenance.
+    The original SHDLDM constructor already builds its subsets; its setup and
+    prepare_data are no-ops. No model inference is performed here.
+    """
+    if (plan.get('status') != 'frozen' or plan.get('purpose') != 'final'
+            or plan.get('test_selects_ideas') is not False
+            or authorization.get('purpose') != 'final'
+            or authorization.get('verified_configurations') != 36
+            or authorization.get('dataset') != 'SHD'):
+        raise ValueError('Complete frozen four-arm final authorization must precede SHD data access')
+    settings = plan.get('shd_generalization', {})
+    if settings.get('ordinary_speaker_breakdown') is not True:
+        raise ValueError('Final plan must preregister the ordinary SHD speaker breakdown')
+    cfg = OmegaConf.to_container(cfg, resolve=True) if OmegaConf.is_config(cfg) else cfg
+    dataset_cfg = cfg.get('dataset', {})
+    if (cfg.get('paper_baseline_dataset') != 'SHD'
+            or dataset_cfg.get('bias_for_test_set', 0) != 0
+            or dataset_cfg.get('test_bias_variant', 'bias') not in ('bias', 'none')
+            or dataset_cfg.get('train_augmentation')):
+        raise ValueError('Final SHD evaluation requires the frozen clean ordinary pipeline')
+    if (type(datamodule.train_val_ds) is not SHDWrapper
+            or type(datamodule.data_train) is not Subset
+            or type(datamodule.data_val) is not Subset
+            or datamodule.data_train.dataset is not datamodule.train_val_ds
+            or datamodule.data_val.dataset is not datamodule.train_val_ds):
+        raise ValueError('Actual fitting/validation subsets must share the original training source')
+    train_file = Path(datamodule.train_val_ds.location_on_system, datamodule.train_val_ds.data_filename)
+    if train_file.name != 'shd_train.h5':
+        raise ValueError('Fitting metadata must come from the official training file')
+    manifest_path = local_path(settings['canonical_split_manifest'], must_exist=True)
+    manifest_bytes = manifest_path.read_bytes()
+    train_sha = _sha256(train_file)
+    with h5py.File(train_file, 'r') as source:
+        train_labels = source['labels'][:].reshape(-1).tolist()
+        train_speakers = source['extra/speaker'][:].reshape(-1).tolist()
+    membership = verify_canonical_fitting_membership(
+        manifest_bytes, settings['canonical_split_manifest_sha256'], train_sha,
+        train_labels, train_speakers, datamodule.data_train.indices,
+        datamodule.data_val.indices, cfg,
+    )
+    raw = datamodule.data_test
+    test_file = local_path(test_file, must_exist=True)
+    if (type(raw) is not SHDWrapper or raw.data_filename != 'shd_test.h5'
+            or Path(raw.location_on_system, raw.data_filename).resolve() != test_file.resolve()
+            or authorization.get('test_data_sha256') != _sha256(test_file)):
+        raise ValueError('Original test source differs from final authorized identity')
+    with h5py.File(test_file, 'r') as source:
+        labels = source['labels'][:].reshape(-1).tolist()
+        speakers = source['extra/speaker'][:].reshape(-1).tolist()
+    if datamodule.batch_size != cfg.get('batch_size'):
+        raise ValueError('Final evaluation batch differs from the frozen checkpoint')
+    loader = DataLoader(raw, shuffle=False, drop_last=False,
+                        batch_size=datamodule.batch_size, collate_fn=datamodule.collate_fn,
+                        num_workers=datamodule.num_workers, pin_memory=True,
+                        persistent_workers=datamodule.num_workers > 0)
+    loader_evidence = verify_original_row_loader(
+        loader, raw, test_file, len(labels), datamodule.batch_size,
+        datamodule.static_data_transform_test,
+    )
+    return dict(loader=loader, metadata_labels=labels, metadata_speakers=speakers,
+                provenance=dict(membership=membership, loader=loader_evidence,
+                                canonical_split_manifest=portable_path(manifest_path),
+                                test_data=portable_path(test_file),
+                                test_data_sha256=authorization['test_data_sha256'],
+                                evaluation_workers=datamodule.num_workers,
+                                ordinary_inference=True, test_time_augmentation=False))
+
+
+def evaluate_prepared_shd(model, trainer, prepared):
+    """Capture exactly the existing ordinary test forwards; verify all totals.
+
+    The caller persists the returned summary/rows with the checkpoint and plan
+    identities. Preparing/calling this outside the frozen gate is prohibited.
+    """
+    count = prepared['provenance']['loader']['recordings']
+    if model.output_size != 20:
+        raise ValueError('Final SHD speaker accounting requires the declared20classes')
+    with capture_ordinary_classification(model, count) as capture:
+        results = trainer.test(model, dataloaders=prepared['loader'])
+        rows = capture.finalize()
+    if len(results) != 1:
+        raise ValueError('Require one complete ordinary SHD test loader')
+    result = results[0]
+    summary = summarize_speaker_generalization(
+        rows['predictions'], rows['observed_labels'], rows['row_ids'],
+        prepared['metadata_labels'], prepared['metadata_speakers'],
+        prepared['provenance']['membership']['fitting_speaker_ids'], num_classes=20,
+    )
+    if (not math.isfinite(float(result['test_acc']))
+            or not math.isclose(float(result['test_acc']), summary['groups']['all']['accuracy'],
+                                rel_tol=0, abs_tol=2e-7)):
+        raise ValueError('Speaker-group counts disagree with the ordinary overall test metric')
+    rows['observed_speaker_ids'] = [prepared['metadata_speakers'][i] for i in rows['row_ids']]
+    return result, dict(summary, provenance=prepared['provenance']), rows
+
+
+_ROW_KEYS = ('row_ids', 'observed_labels', 'predictions', 'observed_speaker_ids')
+_IDENTITY_HASHES = ('checkpoint_sha256', 'evaluation_plan_sha256', 'test_data_sha256',
+                    'training_source_sha256', 'canonical_split_manifest_sha256')
+
+
+def _row_payload(rows, identity):
+    if (not isinstance(identity, dict)
+            or any(not isinstance(identity.get(k), str)
+                   or re.fullmatch('[0-9a-f]{64}', identity[k]) is None for k in _IDENTITY_HASHES)
+            or identity.get('ordinary_inference') is not True
+            or identity.get('test_time_augmentation') is not False):
+        raise ValueError('Prediction rows require exact ordinary checkpoint/plan/data/split identities')
+    fitting = identity.get('fitting_speaker_ids')
+    if (not isinstance(fitting, list) or not fitting
+            or any(isinstance(x, bool) or not isinstance(x, int) or x < 0 for x in fitting)
+            or fitting != sorted(set(fitting))):
+        raise ValueError('Prediction identity requires verified unique fitting speakers')
+    arrays = {}
+    for name in _ROW_KEYS:
+        value = np.asarray(rows.get(name))
+        if value.ndim != 1 or value.dtype.kind not in 'iu' or not len(value):
+            raise ValueError('Prediction rows must contain nonempty aligned integer arrays')
+        if np.any(value < 0) or (name in ('observed_labels', 'predictions') and np.any(value >= 20)):
+            raise ValueError('Prediction row class/speaker/row IDs are invalid')
+        if np.any(value > np.iinfo(np.int64).max):
+            raise ValueError('Prediction IDs exceed the supported integer range')
+        arrays[name] = value.astype(np.int64)
+    n = len(arrays['row_ids'])
+    if (any(len(value) != n for value in arrays.values())
+            or not np.array_equal(arrays['row_ids'], np.arange(n, dtype=np.int64))):
+        raise ValueError('Prediction rows must exhaust original sequential recordings')
+    identity_json = json.dumps(identity, sort_keys=True, separators=(',', ':'))
+    return arrays, identity_json
+
+
+def verify_saved_shd_rows(path, expected_sha256, expected_identity):
+    """Verify a saved ordinary-pass archive without any dataset/model access."""
+    path = Path(path)
+    if _sha256(path) != expected_sha256:
+        raise ValueError('Saved prediction archive hash differs from its result record')
+    try:
+        with np.load(path, allow_pickle=False) as archive:
+            if set(archive.files) != set(_ROW_KEYS) | {'identity_json'}:
+                raise ValueError('Prediction archive has incompatible fields')
+            encoded = archive['identity_json']
+            if encoded.ndim != 0 or encoded.dtype.kind != 'U':
+                raise ValueError('Prediction archive identity must be plain JSON text')
+            identity = json.loads(encoded.item())
+            rows = {name: archive[name].tolist() for name in _ROW_KEYS}
+    except (OSError, ValueError, zipfile.BadZipFile, EOFError, KeyError, TypeError) as exc:
+        raise ValueError('Invalid saved prediction archive; preserve the existing file') from exc
+    _row_payload(rows, identity)
+    if identity != expected_identity:
+        raise ValueError('Saved prediction rows belong to another checkpoint/plan/data identity')
+    return rows
+
+
+def persist_shd_rows(directory, rows, identity):
+    """Create-only ordinary-pass rows; identical reruns reuse existing bytes.
+
+    Output-directory and frozen-plan guards belong to the existing entrypoint.
+    There is no overwrite, candidate selection, fitting or model inference here.
+    """
+    arrays, encoded = _row_payload(rows, identity)
+    directory = Path(directory)
+    target = directory / 'SHD_GENERALIZATION_ROWS.npz'
+    if target.exists():
+        existing = verify_saved_shd_rows(target, _sha256(target), identity)
+        if any(not np.array_equal(arrays[name], np.asarray(existing[name])) for name in _ROW_KEYS):
+            raise ValueError('Existing prediction rows differ; preserve the output and use a versioned directory')
+    else:
+        directory.mkdir(parents=True, exist_ok=True)
+        with target.open('xb') as stream:
+            np.savez_compressed(stream, **arrays, identity_json=np.asarray(encoded))
+    return dict(path=portable_path(target), sha256=_sha256(target), recordings=len(arrays['row_ids']),
+                identity=identity)
+
+
+def shd_prediction_identity(authorization, membership):
+    """Bind a pass to the fully checked plan/checkpoint and fitting provenance."""
+    if (authorization.get('purpose') != 'final'
+            or authorization.get('verified_configurations') != 36
+            or authorization.get('dataset') != 'SHD'):
+        raise ValueError('Final cohort authorization is required for prediction evidence')
+    return dict(checkpoint_sha256=authorization['checkpoint_sha256'],
+                evaluation_plan_sha256=authorization['evaluation_plan_sha256'],
+                test_data_sha256=authorization['test_data_sha256'],
+                training_source_sha256=membership['training_source_sha256'],
+                canonical_split_manifest_sha256=membership['manifest_sha256'],
+                fitting_speaker_ids=membership['fitting_speaker_ids'],
+                ordinary_inference=True, test_time_augmentation=False)
+
+
+def frozen_shd_prediction_identity(plan, authorization):
+    """Expected identity for reusing already verified outputs; no HDF5/model access."""
+    if (plan.get('status') != 'frozen' or plan.get('purpose') != 'final'
+            or plan.get('test_selects_ideas') is not False
+            or authorization.get('verified_configurations') != 36):
+        raise ValueError('Frozen final authorization must precede output reuse')
+    settings = plan.get('shd_generalization', {})
+    if settings.get('ordinary_speaker_breakdown') is not True:
+        raise ValueError('Frozen final SHD plan omits its ordinary speaker breakdown')
+    source = local_path(settings['canonical_split_manifest'], must_exist=True)
+    raw = source.read_bytes();digest = hashlib.sha256(raw).hexdigest()
+    if digest != settings['canonical_split_manifest_sha256']:
+        raise ValueError('Frozen canonical split manifest changed')
+    manifest = json.loads(raw)
+    if (manifest.get('version') != 'canonical_shd_split_v1'
+            or manifest.get('dataset_label') != 'SHD*'):
+        raise ValueError('Final output reuse requires the frozen canonical SHD* split')
+    return shd_prediction_identity(authorization, dict(
+        training_source_sha256=manifest['source_sha256'], manifest_sha256=digest,
+        fitting_speaker_ids=manifest['train']['speaker_ids'],
+    ))
+
+
+def verify_saved_shd_result(evidence, expected_identity, directory):
+    """Reconstruct saved ordinary metrics/groups before accepting an existing result."""
+    record = evidence.get('prediction_rows', {})
+    if (evidence.get('ordinary_inference') is not True
+            or evidence.get('test_time_augmentation') is not False
+            or not evidence.get('speaker_generalization')
+            or record.get('identity') != expected_identity):
+        raise ValueError('Existing final SHD result lacks matching ordinary prediction evidence')
+    actual = local_path(record['path'], must_exist=True)
+    expected = Path(directory).resolve() / 'SHD_GENERALIZATION_ROWS.npz'
+    if actual.resolve() != expected:
+        raise ValueError('Prediction archive must remain beside its exact test result')
+    rows = verify_saved_shd_rows(actual, record['sha256'], expected_identity)
+    if record.get('recordings') != len(rows['row_ids']):
+        raise ValueError('Prediction recording count differs from its result record')
+    summary = summarize_speaker_generalization(
+        rows['predictions'], rows['observed_labels'], rows['row_ids'],
+        rows['observed_labels'], rows['observed_speaker_ids'],
+        expected_identity['fitting_speaker_ids'], num_classes=20,
+    )
+    saved = evidence['speaker_generalization']
+    provenance = saved.get('provenance', {})
+    membership = provenance.get('membership', {})
+    loader = provenance.get('loader', {})
+    if (membership.get('training_source_sha256') != expected_identity['training_source_sha256']
+            or membership.get('manifest_sha256') != expected_identity['canonical_split_manifest_sha256']
+            or membership.get('fitting_speaker_ids') != expected_identity['fitting_speaker_ids']
+            or provenance.get('test_data_sha256') != expected_identity['test_data_sha256']
+            or provenance.get('ordinary_inference') is not True
+            or provenance.get('test_time_augmentation') is not False
+            or loader.get('recordings') != len(rows['row_ids']) or loader.get('cached') is not False
+            or loader.get('drop_last') is not False or loader.get('sampler') != 'SequentialSampler'
+            or loader.get('original_row_order') != '0..N-1'):
+        raise ValueError('Saved final SHD provenance differs from the verified original-row protocol')
+    if any(saved.get(key) != value for key, value in summary.items()):
+        raise ValueError('Saved speaker-group summary differs from the original prediction rows')
+    if not math.isclose(float(evidence['metrics']['test_acc']), summary['groups']['all']['accuracy'],
+                        rel_tol=0, abs_tol=2e-7):
+        raise ValueError('Saved ordinary test metric differs from the original prediction rows')
+    return summary

@@ -0,0 +1,62 @@
+"""Read-only source/output guards for a future frozen final comparison."""
+import hashlib
+from pathlib import Path, PurePosixPath, PureWindowsPath
+import re
+
+
+def evaluation_source_identity(root):
+    """Fingerprint local inference/guard/config code, independent of checkout path.
+
+    Reports, run outputs, tests and command files are excluded. CRLF and LF
+    source copies have the same identity; package versions need separate
+    environment evidence. No model, checkpoint or dataset file is loaded.
+    """
+    root = Path(root).resolve()
+    names = set()
+    for directory in ('models', 'functional', 'datasets', 'module', 'config'):
+        base = root / directory
+        if not base.is_dir():
+            raise ValueError('Missing evaluator source directory: ' + directory)
+        suffixes = {'.yaml', '.yml'} if directory == 'config' else {'.py'}
+        for path in base.rglob('*'):
+            if path.is_file() and path.suffix in suffixes and '__pycache__' not in path.parts:
+                if not path.resolve().is_relative_to(root):
+                    raise ValueError('Evaluator source must remain inside its checkout')
+                names.add(path.relative_to(root).as_posix())
+    for name in ('test_checkpoint.py', 'project_paths.py', 'requirements.txt'):
+        if not (root / name).is_file():
+            raise ValueError('Missing evaluator entrypoint/dependency record: ' + name)
+        names.add(name)
+    files = {name: hashlib.sha256((root / name).read_bytes().replace(b'\r\n', b'\n')).hexdigest()
+             for name in sorted(names)}
+    return dict(version='classification_final_evaluator_v1', normalization='repository-relative paths; CRLF to LF',
+                files_sha256=files)
+
+
+def validate_evaluation_source(plan, root):
+    if plan.get('status') != 'frozen' or plan.get('purpose') != 'final':
+        raise ValueError('Evaluator identity applies only to the frozen final plan')
+    actual = evaluation_source_identity(root)
+    if plan.get('evaluator_source_identity') != actual:
+        raise ValueError('Frozen evaluator implementation is missing or changed; preserve existing evidence')
+    return actual
+
+
+def final_evaluation_directory(plan, root, output):
+    """Require a separately versioned, portable final-output namespace."""
+    raw = plan.get('evaluation_root')
+    if not isinstance(raw, str) or PureWindowsPath(raw).drive or PurePosixPath(raw).is_absolute():
+        raise ValueError('Final evaluation_root must be repository-relative')
+    parts = PurePosixPath(raw).parts
+    if (len(parts) != 4 or parts[:2] != ('results', 'experiments') or parts[-1] != 'evaluations'
+            or parts[2] in ('.', '..') or re.fullmatch('[A-Za-z0-9_.-]+', parts[2]) is None
+            or '\\' in raw):
+        raise ValueError('Use results/experiments/<version>/evaluations for final evidence')
+    root = Path(root).resolve();base = (root / raw).resolve()
+    if not base.is_relative_to(root / 'results/experiments'):
+        raise ValueError('Final evaluation namespace escapes the experiments tree')
+    output = Path(output)
+    output = (output if output.is_absolute() else root / output).resolve()
+    if output == base or not output.is_relative_to(base):
+        raise ValueError('Each final result needs its own directory under the frozen evaluation root')
+    return output

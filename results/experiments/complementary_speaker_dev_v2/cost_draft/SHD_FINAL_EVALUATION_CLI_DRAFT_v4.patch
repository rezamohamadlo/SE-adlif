diff --git a/module/final_config_guard.py b/module/final_config_guard.py
new file mode 100644
--- /dev/null
+++ b/module/final_config_guard.py
@@ -0,0 +1,122 @@
+"""Draft pure configuration guard; no file loading, data access or training."""
+from copy import deepcopy
+import json
+
+ARMS = {'Baseline', 'A', 'B', 'A+B'}
+DATASETS = {'SHD', 'SSC', 'ECG'}
+SEEDS = {42, 123, 456}
+# These identify the run rather than its numerical training configuration.
+RUN_METADATA = {
+    'random_seed', 'logdir', 'exp_name', 'launcher_logdir', 'launcher_script',
+    'run_mode', 'study_hypothesis', 'study_stage', 'ckpt_path',
+}
+# Declared mechanism differences cannot waive these matched-condition checks.
+PROTECTED = {
+    'dataset', 'datadir', 'lr', 'batch_size', 'n_epochs', 'max_epochs',
+    'precision', 'device', 'optimizer', 'weight_decay', 'betas', 'scheduler',
+    'scheduler_min_lr', 'factor', 'patience', 'gradient_clip_val',
+    'early_stopping', 'early_stopping_patience', 'early_stopping_min_delta',
+    'loss_agg', 'paper_baseline', 'paper_baseline_version',
+    'paper_baseline_dataset', 'evaluation_protocol', 'tracking_metric',
+    'tracking_mode', 'stage_ceiling',
+}
+
+
+def _stable(config):
+    if not isinstance(config, dict):
+        raise ValueError('Expected a resolved JSON configuration mapping')
+    return {k: deepcopy(v) for k, v in config.items() if k not in RUN_METADATA}
+
+
+def _comparison_protocol(config):
+    """Ignore only the exact objective annotation for shared-condition checks.
+
+    Each full per-arm protocol string is still checked against its frozen
+    config below. The underlying split/optimization protocol cannot be waived.
+    """
+    protocol = config.get('evaluation_protocol')
+    objective = config.get('training_objective', 'classification')
+    if (isinstance(protocol, str) and isinstance(objective, str)
+            and objective not in ('', 'classification')
+            and protocol.endswith('_' + objective)):
+        return protocol[:-len(objective)-1]
+    return protocol
+
+
+def _remove_path(config, path):
+    parts = path.split('.')
+    node = config
+    for part in parts[:-1]:
+        if not isinstance(node, dict) or part not in node:
+            return
+        node = node[part]
+    if isinstance(node, dict):
+        node.pop(parts[-1], None)
+
+
+def validate_frozen_configurations(plan, cohort):
+    """Validate all 36 checkpoint configs against pre-frozen arm specifications.
+
+    cohort contains (arm, dataset, training_seed, resolved_checkpoint_cfg).
+    The caller must verify checkpoint hashes, source identities and receipts,
+    and pass portable resolved configs read from those exact checkpoints.
+    This helper does not replace those independent provenance checks.
+    """
+    frozen = plan.get('frozen_configurations')
+    differences = plan.get('mechanism_difference_paths')
+    if (not isinstance(frozen, dict) or set(frozen) != DATASETS
+            or not isinstance(differences, list) or not differences
+            or any(not isinstance(p, str) for p in differences)
+            or len(set(differences)) != len(differences)):
+        raise ValueError('Final testing requires frozen per-arm configs and explicit mechanism paths')
+    for path in differences:
+        if (not isinstance(path, str) or not path or any(not p for p in path.split('.'))
+                or path.split('.')[0] in PROTECTED | RUN_METADATA):
+            raise ValueError('Mechanism paths cannot waive matched training conditions')
+    for dataset in DATASETS:
+        if not isinstance(frozen[dataset], dict) or set(frozen[dataset]) != ARMS:
+            raise ValueError('Frozen configurations must specify every arm for every dataset')
+        signatures = set()
+        shared = None
+        for arm in ARMS:
+            spec = _stable(frozen[dataset][arm])
+            computational = deepcopy(spec)
+            # Factory selection must also have explicit mechanism/architecture
+            # settings; renaming a baseline or its deviation note is not an arm.
+            computational.pop('model_variant', None)
+            computational.pop('paper_baseline_deviations', None)
+            signatures.add(json.dumps(computational, sort_keys=True))
+            common = deepcopy(spec)
+            if 'evaluation_protocol' in common:
+                common['evaluation_protocol'] = _comparison_protocol(spec)
+            # Deviations remain verified against each exact frozen arm config.
+            common.pop('paper_baseline_deviations', None)
+            for path in differences:
+                _remove_path(common, path)
+            if shared is None:
+                shared = common
+            elif common != shared:
+                raise ValueError('Frozen arms differ outside their declared mechanisms')
+        if len(signatures) != 4:
+            raise ValueError('Four arm labels must describe four distinct configurations')
+    seen = set()
+    for arm, dataset, seed, config in cohort:
+        identity = (arm, dataset, seed)
+        if arm not in ARMS or dataset not in DATASETS or seed not in SEEDS or identity in seen:
+            raise ValueError('Unexpected or duplicate final cohort identity')
+        seen.add(identity)
+        if config.get('random_seed') != seed or config.get('paper_baseline_dataset') != dataset:
+            raise ValueError('Checkpoint dataset/training seed differs from cohort identity')
+        if config.get('init_ckpt_path'):
+            raise ValueError('Final fresh-training comparison cannot use weights-only initialization')
+        if dataset == 'SHD':
+            data = config.get('dataset', {})
+            if (data.get('validate_on') != 0.2 or data.get('random_seed') != 42
+                    or data.get('speaker_split_manifest') or data.get('speaker_split_fingerprint')):
+                raise ValueError('Canonical SHD* requires its own random20percent split, seed42')
+        if _stable(config) != _stable(frozen[dataset][arm]):
+            raise ValueError('Checkpoint settings differ from the frozen arm configuration')
+    expected = {(a, d, s) for a in ARMS for d in DATASETS for s in SEEDS}
+    if seen != expected:
+        raise ValueError('Final configuration cohort is incomplete')
+    return {'verified_configurations': len(seen), 'matched_shared_conditions': True}
diff --git a/module/speaker_generalization.py b/module/speaker_generalization.py
new file mode 100644
--- /dev/null
+++ b/module/speaker_generalization.py
@@ -0,0 +1,72 @@
+"""Pure accounting for preregistered ordinary speaker-generalization evidence.
+
+No model fitting, file loading or dataset access. Call only after authorized
+final inference, with verified original row IDs and actual fitting speakers.
+"""
+from numbers import Integral
+
+
+def _integers(values, name):
+    values = list(values)
+    if any(isinstance(x, bool) or not isinstance(x, Integral) for x in values):
+        raise ValueError(f'{name} must contain integer IDs')
+    return [int(x) for x in values]
+
+
+def summarize_speaker_generalization(
+    predictions, observed_labels, row_ids, metadata_labels, metadata_speakers,
+    fitting_speaker_ids, num_classes=20,
+):
+    """Require one prediction for every official test row; return all groups.
+
+    Arrays from the same inference must retain exact row IDs. Metadata arrays
+    are indexed by original HDF5 row number. Correct counts reconstruct the
+    overall score exactly; empty subgroups have null accuracies, not zero.
+    This function cannot establish that a caller's row IDs or fitting indices
+    are genuine: the evaluator must verify sampler and dataset provenance.
+    """
+    if isinstance(num_classes, bool) or not isinstance(num_classes, Integral) or num_classes<2:
+        raise ValueError('num_classes must be an integer >=2')
+    predictions = _integers(predictions, 'predictions')
+    labels = _integers(observed_labels, 'observed labels')
+    rows = _integers(row_ids, 'row IDs')
+    raw_labels = _integers(metadata_labels, 'metadata labels')
+    speakers = _integers(metadata_speakers, 'metadata speakers')
+    fitting = set(_integers(fitting_speaker_ids, 'fitting speakers'))
+    n = len(raw_labels)
+    if not fitting or not n or any(len(x)!=n for x in (predictions, labels, rows, speakers)):
+        raise ValueError('Require nonempty fitting speakers and a complete aligned test cohort')
+    if sorted(rows)!=list(range(n)):
+        raise ValueError('Original test row IDs must be unique and exhaustive')
+    if any(x<0 for x in speakers) or any(x<0 for x in fitting):
+        raise ValueError('Speaker IDs must be nonnegative')
+    if any(not 0<=x<num_classes for x in predictions+labels+raw_labels):
+        raise ValueError('Class IDs lie outside the declared class range')
+    if any(label!=raw_labels[row] for label,row in zip(labels,rows)):
+        raise ValueError('Observed labels do not match original-row metadata')
+    by_speaker = {}
+    for prediction, label, row in zip(predictions, labels, rows):
+        speaker = speakers[row]
+        entry = by_speaker.setdefault(speaker, dict(recordings=0,correct=0,class_counts=[0]*num_classes))
+        entry['recordings']+=1
+        entry['correct']+=int(prediction==label)
+        entry['class_counts'][label]+=1
+    for speaker, entry in by_speaker.items():
+        entry['accuracy']=entry['correct']/entry['recordings']
+        entry['seen_during_fitting']=speaker in fitting
+    groups = {}
+    for name in ('all','seen','unseen'):
+        selected=[e for speaker,e in sorted(by_speaker.items())
+                  if name=='all' or (speaker in fitting)==(name=='seen')]
+        count=sum(e['recordings'] for e in selected)
+        correct=sum(e['correct'] for e in selected)
+        counts=[sum(e['class_counts'][c] for e in selected) for c in range(num_classes)]
+        groups[name]=dict(recordings=count,correct=correct,accuracy=correct/count if count else None,
+                          speakers=len(selected),class_counts=counts,
+                          classes_present=[c for c,nc in enumerate(counts) if nc],
+                          macro_speaker_accuracy=sum(e['accuracy'] for e in selected)/len(selected) if selected else None)
+    assert groups['seen']['recordings']+groups['unseen']['recordings']==groups['all']['recordings']==n
+    assert groups['seen']['correct']+groups['unseen']['correct']==groups['all']['correct']
+    return dict(groups=groups,per_speaker={str(s):by_speaker[s] for s in sorted(by_speaker)},
+                fitting_speaker_ids=sorted(fitting),num_classes=int(num_classes),
+                metric='ordinary_recording_accuracy',speaker_population_independence_established=False)
diff --git a/module/ordinary_prediction_capture.py b/module/ordinary_prediction_capture.py
new file mode 100644
--- /dev/null
+++ b/module/ordinary_prediction_capture.py
@@ -0,0 +1,83 @@
+"""Scoped read-only capture of existing SHD test metric inputs.
+
+No forward pass or trainer entrypoint. The caller must enforce the frozen-test
+gate and verify a sequential, complete original-row dataloader separately.
+"""
+from contextlib import contextmanager
+from numbers import Integral
+import torch
+
+
+class ClassificationRows:
+    def __init__(self, expected_records):
+        if isinstance(expected_records,bool) or not isinstance(expected_records,Integral) or expected_records<1:
+            raise ValueError('Expected a positive original test recording count')
+        self.expected_records=int(expected_records)
+        self.predictions=[]
+        self.labels=[]
+
+    def append(self, outputs, targets, classes, ignore_index):
+        integer_types=(torch.uint8,torch.int8,torch.int16,torch.int32,torch.int64)
+        if (not isinstance(targets,torch.Tensor) or targets.ndim!=2
+                or targets.dtype not in integer_types
+                or not isinstance(outputs,torch.Tensor) or outputs.ndim!=2
+                or outputs.shape!=(targets.numel(),classes)):
+            raise ValueError('Capture requires target-aligned classification scores and integer targets')
+        valid=targets.ne(ignore_index)
+        if not torch.all(valid.sum(dim=1)==1).item():
+            raise ValueError('SHD capture requires exactly one valid target per recording')
+        labels=targets.flatten()[valid.flatten()].detach().cpu().tolist()
+        if any(not 0<=label<classes for label in labels):
+            raise ValueError('Observed target outside declared class range')
+        predictions=outputs.detach().argmax(dim=-1)[valid.flatten()].cpu().tolist()
+        if len(self.labels)+len(labels)>self.expected_records:
+            raise ValueError('More predictions than original test recordings')
+        self.labels.extend(labels)
+        self.predictions.extend(predictions)
+
+    def finalize(self):
+        if len(self.labels)!=self.expected_records:
+            raise ValueError('Test prediction capture is incomplete')
+        return dict(row_ids=list(range(self.expected_records)),
+                    observed_labels=list(self.labels),predictions=list(self.predictions))
+
+
+@contextmanager
+def capture_ordinary_classification(model, expected_records):
+    """Preserve original logging method/arguments/results, restoring on error.
+
+    The collector assigns sequential original row IDs. Using it without a
+    verified sequential sampler is invalid, even if labels happen to match.
+    """
+    if getattr(model,'auto_regression',True) or getattr(model,'ignore_target_idx',None)!=-1:
+        raise ValueError('Only the established classification/ignore-target contract is supported')
+    if getattr(model,'_ordinary_prediction_capture_active',False):
+        raise ValueError('Prediction capture is already active')
+    classes=model.output_size
+    original=model.update_and_log_metrics
+    had_override='update_and_log_metrics' in vars(model)
+    previous=vars(model).get('update_and_log_metrics')
+    had_marker='_ordinary_prediction_capture_active' in vars(model)
+    previous_marker=vars(model).get('_ordinary_prediction_capture_active')
+    rows=ClassificationRows(expected_records)
+
+    def observed(outputs,targets,loss,metrics,prefix):
+        if prefix=='test_':
+            if model.training:
+                raise ValueError('Ordinary test capture requires evaluation mode')
+            rows.append(outputs,targets,classes,model.ignore_target_idx)
+        return original(outputs,targets,loss,metrics,prefix)
+
+    model._ordinary_prediction_capture_active=True
+    model.update_and_log_metrics=observed
+    try:
+        yield rows
+    finally:
+        if had_override:
+            model.update_and_log_metrics=previous
+        else:
+            delattr(model,'update_and_log_metrics')
+        if had_marker:
+            model._ordinary_prediction_capture_active=previous_marker
+        else:
+            delattr(model,'_ordinary_prediction_capture_active')

+    def manifest(self):
+        result=dict(version='canonical_shd_split_v1',dataset_label='SHD*',validate_on=.2,
+                    split_seed=42,official_test_opened=False,source_sha256='a'*64)
+        for name,indices in [('train',self.fitting),('validation',self.validation)]:
+            classes=Counter(self.labels[i] for i in indices)
+            speakers=Counter(self.speakers[i] for i in indices)
+            result[name]=dict(indices=list(indices),record_count=len(indices),
+                              class_counts=[classes[i] for i in range(20)],
+                              speaker_ids=sorted(speakers),
+                              per_speaker_record_counts={str(k):v for k,v in speakers.items()})
+        return result

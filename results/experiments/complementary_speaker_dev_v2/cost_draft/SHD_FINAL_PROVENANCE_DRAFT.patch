+++ b/tests/test_shd_final_provenance.py
@@ -0,0 +1,148 @@
+"""Synthetic metadata/HDF5 only; no official data, Trainer or model training."""
+import copy
+import hashlib
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from collections import Counter
+
+import h5py
+import numpy as np
+import torch
+from torch.utils.data import DataLoader, Subset
+from datasets.shd import SHDWrapper
+from datasets.utils.pad_tensors import PadTensors
+from datasets.utils.diskcache import DiskCachedDataset
+from module.shd_final_provenance import (
+    verify_canonical_fitting_membership, verify_original_row_loader,
+)
+from module.ordinary_prediction_capture import capture_ordinary_classification
+from module.speaker_generalization import summarize_speaker_generalization
+from tests.test_ordinary_prediction_capture import LoggingFixture
+
+
+class FittingMembershipTests(unittest.TestCase):
+    def setUp(self):
+        self.labels=[i%20 for i in range(2000)]
+        self.speakers=[i//200 for i in range(2000)]
+        order=torch.randperm(2000,generator=torch.Generator().manual_seed(42)).tolist()
+        self.fitting,self.validation=order[:1600],order[1600:]
+        self.cfg=dict(dataset=dict(validate_on=.2,random_seed=42),init_ckpt_path=None)
+
+    def manifest(self):
+        result=dict(version='canonical_shd_split_v1',dataset_label='SHD*',validate_on=.2,
+                    split_seed=42,official_test_opened=False,source_sha256='a'*64)
+        for name,indices in [('train',self.fitting),('validation',self.validation)]:
+            classes=Counter(self.labels[i] for i in indices)
+            speakers=Counter(self.speakers[i] for i in indices)
+            result[name]=dict(indices=list(indices),record_count=len(indices),
+                              class_counts=[classes[i] for i in range(20)],
+                              speaker_ids=sorted(speakers),
+                              per_speaker_record_counts={str(k):v for k,v in speakers.items()})
+        return result
+
+    def check(self,manifest=None,**overrides):
+        raw=json.dumps(manifest or self.manifest()).encode()
+        values=dict(manifest_bytes=raw,expected_manifest_sha256=hashlib.sha256(raw).hexdigest(),
+                    source_sha256='a'*64,train_labels=self.labels,train_speakers=self.speakers,
+                    fitting_indices=self.fitting,validation_indices=self.validation,cfg=self.cfg)
+        values.update(overrides)
+        return verify_canonical_fitting_membership(**values)
+
+    def test_exact_split_and_membership_without_global_rng_consumption(self):
+        state=torch.get_rng_state().clone()
+        r=self.check()
+        self.assertEqual(r['fitting_records'],1600)
+        self.assertEqual(r['validation_records'],400)
+        self.assertEqual(r['fitting_speaker_ids'],list(range(10)))
+        self.assertTrue(torch.equal(state,torch.get_rng_state()))
+
+    def test_membership_uses_fitting_rows_not_every_training_file_speaker(self):
+        for i in self.validation:self.speakers[i]=99
+        r=self.check()
+        self.assertIn(99,r['training_file_speaker_ids'])
+        self.assertNotIn(99,r['fitting_speaker_ids'])
+
+    def test_frozen_bytes_and_training_source_identity_are_required(self):
+        for overrides in [dict(expected_manifest_sha256='b'*64),dict(source_sha256='b'*64)]:
+            with self.subTest(overrides=overrides),self.assertRaises(ValueError):self.check(**overrides)
+
+    def test_wrong_fitting_exposure_or_order_is_rejected(self):
+        for indices in [self.fitting[:-1],list(reversed(self.fitting)),self.validation]:
+            with self.subTest(indices=len(indices)),self.assertRaises(ValueError):
+                self.check(fitting_indices=indices)
+
+    def test_speaker_holdout_test_selection_and_weights_initialization_are_rejected(self):
+        for cfg in [dict(dataset=dict(validate_on='speaker_holdout',random_seed=42)),
+                    dict(dataset=dict(validate_on=.2,random_seed=7)),
+                    dict(dataset=dict(validate_on=.2,random_seed=42,additional_test_set_validation=True)),
+                    dict(dataset=dict(validate_on=.2,random_seed=42),init_ckpt_path='old.ckpt')]:
+            with self.subTest(cfg=cfg),self.assertRaises(ValueError):self.check(cfg=cfg)
+
+    def test_missing_classes_bad_counts_and_noninteger_metadata_are_rejected(self):
+        with self.assertRaises(ValueError):self.check(train_labels=[0]*2000)
+        m=self.manifest();m['train']['class_counts'][0]+=1
+        with self.assertRaises(ValueError):self.check(manifest=m)
+        with self.assertRaises(ValueError):self.check(train_speakers=[True]*2000)
+
+
+class OriginalRowLoaderTests(unittest.TestCase):
+    def setUp(self):
+        self.temp=tempfile.TemporaryDirectory();self.addCleanup(self.temp.cleanup)
+        self.path=Path(self.temp.name)/'shd_test.h5'  # Synthetic temporary file only.
+        with h5py.File(self.path,'w') as f:
+            f['labels']=np.array([0,1,2],dtype=np.int64)
+            f['spikes/times']=np.array([[.01,.02]]*3,dtype=np.float16)
+            f['spikes/units']=np.arange(6).reshape(3,2)
+        self.raw=object.__new__(SHDWrapper)  # Never call Tonic download/initialization.
+        self.raw.location_on_system=str(self.path.parent);self.raw.data_filename=self.path.name
+        self.raw.ignore_first_timesteps=0;self.raw.target_transform=None
+        self.transform=lambda events:torch.tensor(events['x'].astype(np.float32)).unsqueeze(1)
+        self.raw.transform=self.transform
+
+    def loader(self,**kwargs):
+        values=dict(dataset=self.raw,batch_size=2,shuffle=False,drop_last=False,
+                    num_workers=0,collate_fn=PadTensors());values.update(kwargs)
+        return DataLoader(**values)
+
+    def check(self,loader=None,**kwargs):
+        values=dict(loader=loader or self.loader(),raw_dataset=self.raw,
+                    expected_file=self.path,expected_records=3,expected_batch_size=2,
+                    expected_transform=self.transform);values.update(kwargs)
+        return verify_original_row_loader(**values)
+
+    def test_complete_uncached_sequential_loader(self):
+        r=self.check();self.assertEqual(r['batches'],2);self.assertFalse(r['cached'])
+
+    def test_cache_subset_shuffle_drop_last_and_wrong_batch_are_rejected(self):
+        cache=DiskCachedDataset(self.raw,Path(self.temp.name)/'cache')
+        for loader in [self.loader(dataset=cache),self.loader(dataset=Subset(self.raw,[2,1,0])),
+                       self.loader(shuffle=True),self.loader(drop_last=True),self.loader(batch_size=1)]:
+            with self.subTest(loader=loader),self.assertRaises(ValueError):self.check(loader)
+
+    def test_source_count_label_transform_and_collation_are_checked(self):
+        with self.assertRaises(ValueError):self.check(expected_records=4)
+        with self.assertRaises(ValueError):self.check(expected_file=self.path.parent/'other.h5')
+        with self.assertRaises(ValueError):self.check(self.loader(collate_fn=PadTensors(batch_first=False)))
+        self.raw.target_transform=lambda y:y
+        with self.assertRaises(ValueError):self.check()
+
+    def test_same_ordinary_predictions_reconstruct_every_speaker_group(self):
+        loader=self.loader();self.check(loader);model=LoggingFixture()
+        with capture_ordinary_classification(model,3) as rows:
+            for x,y,b in loader:
+                scores=torch.zeros((y.numel(),3));valid=y.flatten().ne(-1)
+                positions=valid.nonzero().flatten();scores[positions,y.flatten()[valid]]=1
+                model.update_and_log_metrics(scores,y,'loss','metrics','test_')
+            captured=rows.finalize()
+        summary=summarize_speaker_generalization(
+            captured['predictions'],captured['observed_labels'],captured['row_ids'],
+            [0,1,2],[7,8,8],[7],num_classes=3)
+        self.assertEqual(summary['groups']['all']['correct'],3)
+        self.assertEqual(summary['groups']['seen']['recordings'],1)
+        self.assertEqual(summary['groups']['unseen']['recordings'],2)
+        self.assertEqual(model.forward_calls,0)
+
+
+if __name__=='__main__':unittest.main()
